---
// "Order a Directory" modal — preserved from the original Sunfield page.
// It is intentionally DORMANT: there is no trigger button and no client JS
// wired up (matching the original, where both were commented out). Kept here
// so the markup/content isn't lost and can be re-enabled later.
const { order } = Astro.props;
---

<div class="modal-overlay" id="orderModalOverlay">
  <div class="modal">
    <button class="modal-close" id="closeOrderModal">✕</button>
    <div id="orderFormView">
      <h3>Order a Directory</h3>
      <p class="modal-sub">Fill out the form below and we'll be in touch.</p>
      <div class="form-group">
        <label>Full Name *</label>
        <input type="text" id="o-name" placeholder="e.g. Jane Smith" />
      </div>
      <div class="form-group">
        <label>Street Address *</label>
        <input type="text" id="o-address" placeholder={order.addressPlaceholder} />
      </div>
      <p style="font-size:0.8rem; color:var(--mid-gray); font-style:italic; margin-bottom:20px; line-height:1.5; border-top:1px solid var(--border); padding-top:16px;">
        {order.priceLine}
      </p>
      <button class="submit-btn" id="orderSubmitBtn">Submit Order</button>
    </div>
    <div class="thank-you" id="orderThankYouView">
      <div class="ty-icon">📖</div>
      <h4>Order Received</h4>
      <p>Thank you! We'll be in touch shortly with delivery details.</p>
    </div>
  </div>
</div>
