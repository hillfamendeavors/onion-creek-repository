---
import { neighborhoods } from '../data/neighborhoods.js';

interface Props {
  currentSlug: string;
  isCalendarPage?: boolean;
  showAllLink?: boolean;
}

const { currentSlug, isCalendarPage = false, showAllLink = true } = Astro.props;
const current = neighborhoods.find((n) => n.slug === currentSlug) || neighborhoods[0];
---

<div class="directory-nav-cluster">
  {showAllLink && (
    <a class="header-link" href="/">← All Directories</a>
  )}
  
  <div class="neighborhood-switcher-wrap">
    <button
      type="button"
      class="neighborhood-switcher-btn"
      aria-expanded="false"
      aria-haspopup="true"
      aria-label={`Current directory: ${current.name}. Click to switch directory.`}
    >
      <svg class="pin-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span class="switcher-btn-text">Switch Directory</span>
      <svg class="chevron-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="neighborhood-dropdown-card" style="display:none;" role="menu" aria-label="Austin Neighborhood Directories">
      <div class="dropdown-header">
        <span>Austin Neighborhoods</span>
      </div>
      <div class="dropdown-items-list">
        {neighborhoods.map((n) => {
          const isCurrent = n.slug === currentSlug;
          const targetUrl = isCalendarPage ? `/${n.slug}/requests/` : `/${n.slug}/`;

          return (
            <div class={`dropdown-item-row ${isCurrent ? 'is-active' : ''}`} role="none">
              <a href={targetUrl} class="dropdown-neigh-link" role="menuitem">
                <span class="neigh-bullet">{isCurrent ? '✓' : '•'}</span>
                <span class="neigh-title">{n.name}</span>
                {isCurrent && <span class="neigh-curr-tag">Active</span>}
              </a>
              <div class="dropdown-quick-links">
                <a href={`/${n.slug}/`} class={`quick-sub-link ${!isCalendarPage && isCurrent ? 'sub-active' : ''}`} title={`${n.name} Directory`}>
                  Dir
                </a>
                <a href={`/${n.slug}/requests/`} class={`quick-sub-link ${isCalendarPage && isCurrent ? 'sub-active' : ''}`} title={`${n.name} Service Calendar`}>
                  Cal ↗
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</div>

<script>
  function setupNeighborhoodSwitchers() {
    document.querySelectorAll('.neighborhood-switcher-btn').forEach((btn) => {
      if (btn.hasAttribute('data-switcher-initialized')) return;
      btn.setAttribute('data-switcher-initialized', 'true');

      const wrap = btn.closest('.neighborhood-switcher-wrap');
      const card = wrap ? wrap.querySelector('.neighborhood-dropdown-card') as HTMLElement : null;
      if (!card) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isCurrentlyOpen = card.style.display === 'block';
        
        // Close all dropdowns
        document.querySelectorAll('.neighborhood-dropdown-card').forEach((c) => {
          (c as HTMLElement).style.display = 'none';
        });
        document.querySelectorAll('.neighborhood-switcher-btn').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
        });

        if (!isCurrentlyOpen) {
          card.style.display = 'block';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  // Global dismiss handlers (click outside + Escape key)
  if (!(window as any).__neighborhoodSwitcherBound) {
    (window as any).__neighborhoodSwitcherBound = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.neighborhood-switcher-wrap')) {
        document.querySelectorAll('.neighborhood-dropdown-card').forEach((c) => {
          (c as HTMLElement).style.display = 'none';
        });
        document.querySelectorAll('.neighborhood-switcher-btn').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
        });
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.neighborhood-dropdown-card').forEach((c) => {
          (c as HTMLElement).style.display = 'none';
        });
        document.querySelectorAll('.neighborhood-switcher-btn').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
        });
      }
    });
  }

  // Run on DOM ready & dynamic navigation
  setupNeighborhoodSwitchers();
  document.addEventListener('DOMContentLoaded', setupNeighborhoodSwitchers);
  document.addEventListener('astro:page-load', setupNeighborhoodSwitchers);
</script>
