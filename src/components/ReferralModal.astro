---
// The "Suggest a Referral" modal + floating button. The neighborhood name and
// email subject prefix are passed through to the client via data attributes
// on #modalOverlay (read by directory.js on submit, sent to the
// notify-referral Netlify function). `groups` is always passed by the caller.
const { neighborhoodName, subjectPrefix, groups } = Astro.props;
---

<button class="fab" id="openModal">+ Suggest a Referral</button>

<div class="modal-overlay" id="modalOverlay" data-neighborhood={neighborhoodName} data-subject={subjectPrefix}>
  <div class="modal">
    <button class="modal-close" id="closeModal">✕</button>
    <div id="formView">
      <h3>Suggest a Referral</h3>
      <p class="modal-sub">Know a great local business? Share them with the community.</p>
      <div class="form-group">
        <label>Business or Person Name *</label>
        <input type="text" id="f-name" placeholder="e.g. Mike's Plumbing" />
      </div>
      <div class="form-group">
        <label>Phone Number *</label>
        <input type="tel" id="f-phone" placeholder="(512) 555-0000" inputmode="tel" maxlength="14" pattern="\(\d{3}\) \d{3}-\d{4}" />
      </div>
      <div class="form-group">
        <label>Your Name (Referrer) *</label>
        <input type="text" id="f-referrer" placeholder="e.g. Marconi A." />
      </div>
      <div class="form-group">
        <label>Email <span style="font-weight:300;text-transform:none;letter-spacing:0">(optional)</span></label>
        <input type="email" id="f-email" placeholder="business@example.com" />
      </div>
      <div class="form-group">
        <label>Website <span style="font-weight:300;text-transform:none;letter-spacing:0">(optional)</span></label>
        <input type="url" id="f-website" placeholder="https://..." />
      </div>
      <div class="form-group">
        <label>Category <span style="font-weight:300;text-transform:none;letter-spacing:0">(optional)</span></label>
        <select id="f-category">
          <option value="">— Select a category —</option>
          {groups.map((g) => (
            <optgroup label={g.label}>
              {g.subcategories.map((sub) => (
                <option>{sub.name}</option>
              ))}
            </optgroup>
          ))}
          <option value="Other">Other</option>
        </select>
        <input type="text" id="f-category-other" placeholder="Enter custom category" style="display:none; margin-top:8px;" />
      </div>
      <div class="form-group">
        <label>Why do you recommend them? *</label>
        <textarea id="f-note" placeholder="e.g. Fixed our water heater same day, very honest pricing…"></textarea>
      </div>
      <button class="submit-btn" id="submitBtn">Submit Referral</button>
    </div>
    <div class="thank-you" id="thankYouView">
      <div class="ty-icon">🌿</div>
      <h4>Thank you, neighbor.</h4>
      <p>Your referral has been submitted and will be reviewed before being added to the directory.</p>
    </div>
  </div>
</div>
