---
// The "Suggest a Referral" modal + floating button. The neighborhood name and
// email subject prefix are passed through to the client via data attributes
// on #modalOverlay (read by directory.js on submit, sent to the
// notify-referral Netlify function).
const { neighborhoodName, subjectPrefix, groups } = Astro.props;
---

<button class="fab" id="openModal">+ Suggest a Referral</button>

<div class="modal-overlay" id="modalOverlay" data-neighborhood={neighborhoodName} data-subject={subjectPrefix}>
  <div class="modal">
    <button class="modal-close" id="closeModal">✕</button>
    <div id="formView">
      <h3>Suggest a Referral</h3>
      <p class="modal-sub">Know a great local business? Share them with the community.</p>
      <div class="form-group">
        <label>Business or Person Name *</label>
        <input type="text" id="f-name" placeholder="e.g. Mike's Plumbing" />
      </div>
      <div class="form-group">
        <label>Phone Number *</label>
        <input type="tel" id="f-phone" placeholder="(512) 555-0000" inputmode="tel" maxlength="14" pattern="\(\d{3}\) \d{3}-\d{4}" />
      </div>
      <div class="form-group">
        <label>Your Name (Referrer) *</label>
        <input type="text" id="f-referrer" placeholder="e.g. Marconi A." />
      </div>
      <div class="form-group">
        <label>Category <span style="font-weight:300;text-transform:none;letter-spacing:0">(optional)</span></label>
        <select id="f-category">
          <option value="">— Select a category —</option>
          {groups ? (
            groups.map((g) => (
              <optgroup label={g.label}>
                {g.subcategories.map((sub) => (
                  <option>{sub.name}</option>
                ))}
              </optgroup>
            ))
          ) : (
            <>
              <optgroup label="Home &amp; Repair">
                <option>Plumbers</option><option>Electricians</option><option>Appliance Repair</option><option>Roofers</option><option>Gutters</option>
                <option>Handyman</option><option>Construction</option><option>Fencing &amp; Decks</option>
                <option>AC &amp; Heating</option><option>Painters</option><option>Interior Designers</option>
              </optgroup>
              <optgroup label="Outdoor &amp; Lawn">
                <option>Landscaping</option><option>Window Cleaning/Exterior Cleaning</option><option>Tree Care</option><option>Mosquito &amp; Pest Control</option><option>Pool Cleaning &amp; Service</option><option>Irrigation</option>
              </optgroup>
              <optgroup label="Auto &amp; Transport">
                <option>Mechanics &amp; Auto Repair</option><option>Golf Cart Sales &amp; Repair</option>
              </optgroup>
              <optgroup label="Professional Services">
                <option>Accounting &amp; Tax Services</option>
                <option>Real Estate Agents</option><option>Real Estate Attorney</option><option>Insurance Agents</option><option>Notary Services</option>
              </optgroup>
              <optgroup label="Health &amp; Wellness">
                <option>Doctors &amp; Healthcare</option><option>Gyms</option><option>Travel Agent</option>
              </optgroup>
              <optgroup label="Kids &amp; Education">
                <option>Childcare</option><option>Babysitting &amp; Nannies</option>
                <option>Camps & Sports Leagues</option><option>Hobby &amp; Entertainment</option>
              </optgroup>
              <optgroup label="Home Life">
                <option>House Cleaning</option>
                <option>Junk Removal</option><option>Tailors &amp; Alterations</option><option>Movers</option>
              </optgroup>
              <optgroup label="Pets">
                <option>Veterinarians</option><option>Pet Services</option>
              </optgroup>
            </>
          )}
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label>Why do you recommend them? *</label>
        <textarea id="f-note" placeholder="e.g. Fixed our water heater same day, very honest pricing…"></textarea>
      </div>
      <button class="submit-btn" id="submitBtn">Submit Referral</button>
    </div>
    <div class="thank-you" id="thankYouView">
      <div class="ty-icon">🌿</div>
      <h4>Thank you, neighbor.</h4>
      <p>Your referral has been submitted and will be reviewed before being added to the directory.</p>
    </div>
  </div>
</div>
