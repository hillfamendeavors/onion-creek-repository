---
// Landing page for Supabase's password-recovery email link. Supabase's JS
// client auto-detects the recovery token in the URL and creates a session;
// this page just prompts for and submits the new password.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reset Password</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; padding: 24px; background: #f7f7f5; color: #222; }
      h1 { font-size: 1.3rem; margin-bottom: 16px; }
      #resetView, #invalidView, #successView { max-width: 320px; margin: 80px auto; }
      #resetView input { display: block; width: 100%; box-sizing: border-box; margin-bottom: 10px; padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
      #resetView button { padding: 8px 16px; border: none; border-radius: 4px; background: #1a3a2a; color: #fff; cursor: pointer; }
      #resetError { color: #b00020; font-size: 0.85rem; min-height: 1.2em; }
      #invalidView, #successView { display: none; }
      #successView a { color: #1a3a2a; }
    </style>
  </head>
  <body>
    <div id="resetView">
      <h1>Set a New Password</h1>
      <input type="password" id="newPassword" placeholder="New password (at least 6 characters)" autocomplete="new-password" />
      <input type="password" id="confirmPassword" placeholder="Confirm new password" autocomplete="new-password" />
      <button id="resetBtn">Set Password</button>
      <p id="resetError"></p>
    </div>
    <div id="invalidView">
      <h1>Link Invalid or Expired</h1>
      <p>This password reset link is no longer valid. Request a new one from the login form.</p>
    </div>
    <div id="successView">
      <h1>Password Updated</h1>
      <p>You can now <a href="/">return to the site</a> and log in with your new password.</p>
    </div>

    <script src="../scripts/reset-password.js"></script>
  </body>
</html>
