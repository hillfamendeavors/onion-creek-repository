---
import Directory from '../../layouts/Directory.astro';
import RequestModal from '../../components/RequestModal.astro';
import NeighborhoodSwitcher from '../../components/NeighborhoodSwitcher.astro';
import { getNeighborhoodDataPaths } from '../../lib/neighborhoodData.js';

export async function getStaticPaths() {
  return await getNeighborhoodDataPaths();
}

const { neighborhood, groups } = Astro.props;
---

<Directory
  title={`${neighborhood.name} Service Request Calendar`}
  description={`See which home services your ${neighborhood.name} neighbors need and when. Share an appointment, split a trip charge, or post your own free service request.`}
  footerLabel={neighborhood.footerLabel}
  theme={neighborhood.theme}
>
  <header>
    <div class="logo-wrap">
      <h1>{neighborhood.name} <span>Service Requests</span></h1>
      <p class="header-sub">See when your neighbors need service appointments & join in</p>
      <div class="calendar-header-actions">
        <a class="header-link" href={`/${neighborhood.slug}/`}>← Back to Directory</a>
        <NeighborhoodSwitcher currentSlug={neighborhood.slug} isCalendarPage={true} showAllLink={false} />
        <button class="btn-post-calendar-req" id="openCalendarPostReqBtn" type="button">
          + Post Service Request
        </button>
      </div>
    </div>
  </header>

  <main data-neighborhood={neighborhood.slug} data-neighborhood-name={neighborhood.name}>
    <!-- Auth Notice Banner -->
    <div id="requestsAuthPrompt" class="request-auth-banner" style="display:none;">
      <div class="auth-banner-content">
        <span class="auth-banner-icon">🔒</span>
        <div>
          <strong>Viewing Public Demand Overview</strong>
          <p>Dates with active requests are highlighted below. Log in to unlock neighbor names, notes, and contact info.</p>
        </div>
      </div>
      <a class="auth-banner-btn" id="rpLoginLink" href="/account/">Log In / Register to Unlock</a>
    </div>

    <!-- Category & My Requests Filter Bar -->
    <div class="calendar-filter-bar" id="calendarFilterBar">
      <div class="filter-pills-scroll">
        <button class="filter-pill active" data-category="all" type="button">All Categories</button>
        <button class="filter-pill my-requests" id="filterMyRequestsBtn" style="display:none;" data-my="true" type="button">
          🌟 My Requests <span class="my-req-count" id="myReqCountBadge">0</span>
        </button>
        <button class="filter-pill" data-category="Plumbing" type="button">🪠 Plumbing</button>
        <button class="filter-pill" data-category="Electrical" type="button">⚡ Electrical</button>
        <button class="filter-pill" data-category="Handyman" type="button">🔨 Handyman</button>
        <button class="filter-pill" data-category="Landscaping & Tree Care" type="button">🌳 Landscaping & Trees</button>
        <button class="filter-pill" data-category="Roofing & Gutters" type="button">🏠 Roofing & Gutters</button>
        <button class="filter-pill" data-category="HVAC & AC" type="button">❄️ HVAC & AC</button>
        <button class="filter-pill" data-category="House Cleaning" type="button">🧹 Cleaning</button>
        <button class="filter-pill" data-category="Pest Control" type="button">🐜 Pest Control</button>
        <button class="filter-pill" data-category="Painting" type="button">🎨 Painting</button>
        <button class="filter-pill" data-category="Other" type="button">📦 Other</button>
      </div>
    </div>

    <!-- View Switcher & Month Navigation Controls -->
    <div class="calendar-controls-bar">
      <div class="view-switcher">
        <button class="view-tab active" id="viewCalendarBtn">📅 Calendar View</button>
        <button class="view-tab" id="viewListBtn">📋 List View</button>
      </div>

      <div class="month-nav" id="monthNav">
        <button class="month-nav-btn" id="prevMonthBtn">‹</button>
        <span class="month-label" id="currentMonthLabel">May 2026</span>
        <button class="month-nav-btn" id="nextMonthBtn">›</button>
        <button class="today-btn" id="todayBtn">Today</button>
      </div>
    </div>

    <!-- Calendar View Container -->
    <div id="requestsCalendarView">
      <div class="calendar-wrapper">
        <div class="calendar-header-row">
          <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
        </div>
        <div class="calendar-grid" id="calendarGrid">
          <div class="request-loading">Loading calendar…</div>
        </div>
      </div>
    </div>

    <!-- Traditional List View Container -->
    <div id="requestsListView" style="display:none;">
      <div id="requestsListContent"></div>
    </div>

    <!-- Request Detail Modal -->
    <div class="modal-overlay" id="requestDetailModal" style="display:none;">
      <div class="modal-card">
        <button class="modal-close-btn" id="closeDetailModalBtn">×</button>
        <div id="modalHeader">
          <h3 id="modalDateTitle">Service Requests for Date</h3>
          <p id="modalSubTitle">Neighborhood Demand Overview</p>
        </div>
        <div id="modalBody">
          <!-- Dynamic Content: Locked Prompt or Unlocked Details -->
        </div>
      </div>
    </div>

    <!-- In-Page Admin Edit Request Modal -->
    <div class="modal-overlay" id="adminRequestEditModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; justify-content:center; align-items:center;">
      <div class="modal-card" style="max-width:540px; width:92%; max-height:90vh; overflow-y:auto; padding:24px; background:#fff; border-radius:12px; box-shadow:0 20px 25px -5px rgba(0,0,0,0.2);">
        <button class="modal-close-btn" id="closeAdminEditModalBtn">×</button>
        <div style="margin-bottom:16px;">
          <h3 style="margin:0 0 4px 0; color:#064E3B; font-size:1.2rem; display:flex; align-items:center; gap:8px;">
            🛡️ Admin Edit Request
          </h3>
          <p style="margin:0; font-size:0.85rem; color:#64748B;">Modify service appointment details &amp; status</p>
        </div>
        <form id="adminRequestEditForm">
          <input type="hidden" id="admEditId" />

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
            <div>
              <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Category *</label>
              <input type="text" id="admEditCategory" required style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; box-sizing:border-box;" />
            </div>
            <div>
              <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Date Needed *</label>
              <input type="date" id="admEditDate" required style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; box-sizing:border-box;" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
            <div>
              <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Status *</label>
              <select id="admEditStatus" required style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; background:#fff; box-sizing:border-box;">
                <option value="new">New (Active)</option>
                <option value="contacted">Contacted (In Progress)</option>
                <option value="completed">Completed (Fulfilled)</option>
                <option value="closed">Closed (Cancelled)</option>
              </select>
            </div>
            <div>
              <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Requester Name *</label>
              <input type="text" id="admEditName" required style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; box-sizing:border-box;" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
            <div>
              <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Phone Number *</label>
              <input type="tel" id="admEditPhone" required style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; box-sizing:border-box;" />
            </div>
            <div>
              <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Email</label>
              <input type="email" id="admEditEmail" style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; box-sizing:border-box;" />
            </div>
          </div>

          <div style="margin-bottom:18px;">
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Details / Notes</label>
            <textarea id="admEditNotes" rows="3" style="width:100%; padding:8px 10px; font-size:0.88rem; border:1px solid #CBD5E1; border-radius:6px; resize:vertical; font-family:inherit; box-sizing:border-box;"></textarea>
          </div>

          <div style="display:flex; justify-content:flex-end; gap:10px;">
            <button type="button" id="closeAdminEditBtn" style="padding:8px 16px; font-size:0.85rem; font-weight:600; border:1px solid #CBD5E1; background:#F8FAFC; border-radius:6px; cursor:pointer;">Cancel</button>
            <button type="submit" id="saveAdminEditBtn" style="padding:8px 18px; font-size:0.85rem; font-weight:700; background:#064E3B; color:#fff; border:none; border-radius:6px; cursor:pointer;">Save Changes</button>
          </div>
        </form>
      </div>
    </div>

    <RequestModal neighborhood={neighborhood} groups={groups} />
  </main>
</Directory>

<script src="../../scripts/requests-page.js"></script>
