---
import Directory from '../layouts/Directory.astro';
import ListingsTree from '../components/ListingsTree.astro';
import ReferralModal from '../components/ReferralModal.astro';
import RequestModal from '../components/RequestModal.astro';
import OrderModal from '../components/OrderModal.astro';
import { neighborhoods } from '../data/neighborhoods.js';
import { supabase } from '../lib/supabase.js';

import averyRanch from '../data/avery-ranch.json';
import circleC from '../data/circle-c.json';
import onionCreek from '../data/onion-creek.json';
import sunfield from '../data/sunfield.json';

const fallbackGroupsBySlug = {
  'avery-ranch': averyRanch,
  'circle-c': circleC,
  'onion-creek': onionCreek,
  'sunfield': sunfield,
};

export async function getStaticPaths() {
  let groupRows = null;
  let subRows = null;
  let nsRows = null;
  let listingRows = null;

  try {
    const res1 = await supabase.from('groups').select('id, slug, label, icon').order('sort_order');
    const res2 = await supabase.from('subcategories').select('id, group_id, name, icon').order('sort_order');
    const res3 = await supabase.from('neighborhood_subcategories').select('neighborhood_slug, subcategory_id');
    const res4 = await supabase.from('listings').select('*').order('sort_order');

    groupRows = res1.data;
    subRows = res2.data;
    nsRows = res3.data;
    listingRows = res4.data;
  } catch (e) {
    console.warn('Supabase build fetch notice:', e);
  }

  const hasDbData = groupRows && subRows && nsRows && listingRows;

  return neighborhoods.map((n) => {
    let groups = [];

    if (hasDbData) {
      const enabledSubIds = new Set(
        (nsRows || []).filter((r) => r.neighborhood_slug === n.slug).map((r) => r.subcategory_id)
      );

      groups = (groupRows || []).map((g) => ({
        id: g.slug,
        label: g.label,
        icon: g.icon,
        subcategories: (subRows || [])
          .filter((s) => s.group_id === g.id && enabledSubIds.has(s.id))
          .map((s) => ({
            name: s.name,
            icon: s.icon,
            listings: (listingRows || [])
              .filter((l) => l.subcategory_id === s.id && l.neighborhood_slug === n.slug)
              .map((l) => ({
                name: l.name,
                phone: l.phone,
                note: l.note,
                ...(l.email ? { email: l.email } : {}),
                ...(l.website ? { website: l.website } : {}),
                ...(l.featured ? { featured: true } : {}),
              })),
          })),
      }));
    } else {
      groups = fallbackGroupsBySlug[n.slug] || [];
    }

    return { params: { neighborhood: n.slug }, props: { neighborhood: n, groups } };
  });
}

const { neighborhood, groups } = Astro.props;

const total = groups.reduce(
  (sum, g) => sum + g.subcategories.reduce((s, sub) => s + sub.listings.length, 0),
  0
);
---

<Directory title={neighborhood.title} footerLabel={neighborhood.footerLabel} theme={neighborhood.theme}>
  <header>
    <div class="logo-wrap">
      <h1>{neighborhood.name} <span>Directory</span></h1>
      <p class="header-sub">Trusted Neighbors &middot; Austin, Texas</p>
      <a class="order-btn" href="/">Back Home</a>
      <a class="order-btn" href={`/${neighborhood.slug}/requests/`}>📅 Service Calendar</a>
    </div>

    <nav class="nav-tabs" id="groupPills">
      <button class="nav-tab active" data-gid="all">All ({total})</button>
      {groups.map((g) => <button class="nav-tab" data-gid={g.id}>{g.label}</button>)}
    </nav>
  </header>

  <div class="search-bar">
    <input type="text" id="search" placeholder="Search by name, service, or keyword…" />
  </div>

  <main>
    <ListingsTree groups={groups} />
  </main>

  <ReferralModal neighborhoodName={neighborhood.name} subjectPrefix={neighborhood.subjectPrefix} groups={groups} />
  <RequestModal groups={groups} neighborhood={neighborhood} />
  {neighborhood.order && <OrderModal order={neighborhood.order} />}
</Directory>
