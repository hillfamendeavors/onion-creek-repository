---
import '../styles/directory.css';
import { neighborhoods } from '../data/neighborhoods.js';

// The one auth surface for the whole site. Borrows the Onion Creek palette
// as the default brand look since this page isn't tied to a neighborhood.
const theme = neighborhoods.find((n) => n.slug === 'onion-creek').theme;
const themeCss = `:root{${Object.entries(theme).map(([k, v]) => `${k}:${v};`).join('')}}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In · Trusted Neighbors</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global set:html={themeCss}></style>
    <link
      href="https://fonts.googleapis.com/css2?family=Chronicles&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      .login-wrap { max-width: 380px; margin: 60px auto; padding: 0 20px; }
      .login-wrap h1 { font-size: 1.6rem; margin-bottom: 8px; }
      .login-back { display: inline-block; margin-top: 20px; font-size: 0.8rem; color: var(--phone); }
    </style>
  </head>
  <body>
    <div class="top-bar">Austin, Texas &nbsp;·&nbsp; Neighbor-Sourced Referrals</div>
    <div class="login-wrap">
      <h1>Log In</h1>
      <p class="modal-sub">Log in or create a free account to post a request and see who your neighbors are looking for.</p>

      <div id="loggedInView" style="display:none;">
        <p class="auth-notice">You're already logged in.</p>
      </div>

      <div id="loginFormView">
        <div class="form-group">
          <label>Email *</label>
          <input type="email" id="login-email" placeholder="you@example.com" autocomplete="username" />
        </div>
        <div class="form-group">
          <label>Password *</label>
          <input type="password" id="login-password" placeholder="At least 6 characters" autocomplete="current-password" />
        </div>
        <button class="submit-btn" id="loginSignInBtn">Log In</button>
        <button class="submit-btn" id="loginSignUpBtn">Sign Up</button>
        <button type="button" class="link-btn" id="loginForgotBtn">Forgot password?</button>
        <p class="auth-error" id="loginError"></p>
        <p class="auth-notice" id="loginSignupNotice" style="display:none;">Check your email to confirm your account, then log in above.</p>
        <p class="auth-notice" id="loginResetNotice" style="display:none;">Check your email for a password reset link.</p>
      </div>

      <a class="login-back" href="/">← Back home</a>
    </div>

    <script src="../scripts/login-page.js"></script>
  </body>
</html>
