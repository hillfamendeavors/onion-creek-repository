---
export const prerender = false;
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = 'https://dktjutawxktwhuhuwbit.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_mlELgE-THem4tud6GIQaZA_NjT9D2ZM';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
let isAdminSession = false;

if (accessToken) {
  try {
    const authSupabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      global: { headers: { Authorization: `Bearer ${accessToken}` } },
      auth: { persistSession: false }
    });

    const { data: { user }, error: userError } = await authSupabase.auth.getUser(accessToken);
    if (user && !userError) {
      const { data: isAdmin } = await authSupabase.rpc('is_admin');
      if (isAdmin) {
        isAdminSession = true;
      }
    }
  } catch (e) {
    console.warn('Admin token check error during SSR:', e);
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Service Requests — Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

      :root {
        --color-primary: #064E3B; /* Forest Green */
        --color-on-primary: #FFFFFF;
        --color-secondary: #047857; /* Light Forest Green */
        --color-accent: #D97706; /* Gold */
        --color-background: #F9FAFB; /* Off-white / Cream */
        --color-foreground: #111827; /* Dark Gray */
        --color-muted: #FFFFFF; /* White Cards */
        --color-border: #E5E7EB; /* Light Gray Borders */
        --color-destructive: #DC2626;
        --color-ring: rgba(6, 78, 59, 0.4);

        --space-xs: 4px;
        --space-sm: 8px;
        --space-md: 16px;
        --space-lg: 24px;
        --space-xl: 32px;
        --space-2xl: 48px;

        --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
      }

      body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        background: var(--color-background);
        color: var(--color-foreground);
        line-height: 1.5;
        min-height: 100vh;
      }

      h1, h2, h3, h4, h5, h6, th, .btn-primary, .btn-secondary, .tab-btn {
        font-family: 'Inter', sans-serif;
      }

      h1 { font-size: 1.5rem; margin: 0; font-weight: 600; letter-spacing: -0.02em; }
      
      .container { max-width: 1200px; margin: 0 auto; padding: var(--space-xl) var(--space-lg); }

      #loginView {
        max-width: 380px; margin: 120px auto; padding: var(--space-xl);
        background: var(--color-muted); border-radius: 12px; box-shadow: var(--shadow-lg);
        border: 1px solid var(--color-border);
      }
      #loginView h1 { margin-bottom: var(--space-lg); text-align: center; color: var(--color-primary); }
      
      .input {
        display: block; width: 100%; box-sizing: border-box;
        margin-bottom: var(--space-md); padding: 12px 16px;
        background: #FFFFFF; color: var(--color-foreground);
        border: 1px solid var(--color-border); border-radius: 8px; font-size: 16px;
        transition: border-color 200ms ease, box-shadow 200ms ease;
        font-family: 'Inter', sans-serif;
      }
      .input:focus { border-color: var(--color-primary); outline: none; box-shadow: 0 0 0 3px var(--color-ring); }

      .btn-primary {
        width: 100%; background: var(--color-accent); color: white;
        padding: 12px 24px; border-radius: 8px; font-weight: 600;
        transition: all 200ms ease; cursor: pointer; border: none; font-size: 1rem;
      }
      .btn-primary:hover { background: #b45f06; transform: translateY(-1px); }

      #loginError { color: var(--color-destructive); font-size: 0.9rem; min-height: 1.2em; margin-top: var(--space-sm); text-align: center; }
      
      .topbar {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-md) var(--space-lg);
        background: var(--color-muted); border-bottom: 1px solid var(--color-border);
      }
      
      .topbar-right { display: flex; align-items: center; gap: var(--space-md); }
      
      .btn-secondary {
        background: #F3F4F6; color: var(--color-foreground);
        border: 1px solid var(--color-border); padding: 8px 16px;
        border-radius: 6px; font-weight: 500; transition: all 200ms ease;
        cursor: pointer; font-size: 0.875rem;
      }
      .btn-secondary:hover { background: #E5E7EB; }

      .tabs-container { margin-bottom: var(--space-xl); border-bottom: 1px solid var(--color-border); padding-bottom: 0; }
      .tabs, .dir-subtabs { display: flex; gap: var(--space-md); }
      
      .tab-btn {
        padding: 12px 20px; border: none; background: transparent; color: #6B7280;
        border-radius: 0; cursor: pointer; font-size: 0.95rem; font-weight: 600;
        transition: all 200ms ease; border-bottom: 3px solid transparent;
        margin-bottom: -1px;
      }
      .tab-btn:hover { color: var(--color-foreground); }
      .tab-btn.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

      .filters { display: flex; gap: var(--space-md); margin-bottom: var(--space-lg); flex-wrap: wrap; }
      
      .select-input {
        padding: 10px 14px; background: #FFFFFF; color: var(--color-foreground);
        border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.9rem;
        cursor: pointer;
      }
      .select-input:focus { border-color: var(--color-primary); outline: none; box-shadow: 0 0 0 3px var(--color-ring); }

      .card {
        background: var(--color-muted); border-radius: 12px;
        border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);
        overflow: hidden;
      }

      .table-scroll { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
      th, td { text-align: left; padding: 16px 20px; border-bottom: 1px solid var(--color-border); vertical-align: middle; }
      th { background: #F9FAFB; font-weight: 600; color: #4B5563; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
      
      tr:nth-child(even) { background: #F9FAFB; }
      tr:hover td { background: #F3F4F6; }
      
      select.status, select.ref-status {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.825rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--color-border);
        transition: all 0.2s ease;
        background: #FFFFFF;
      }
      select.status[data-value="new"], select.ref-status[data-value="new"] {
        background: #FEF3C7;
        color: #92400E;
        border-color: #FDE68A;
      }
      select.status[data-value="contacted"], select.ref-status[data-value="approved"] {
        background: #D1FAE5;
        color: #065F46;
        border-color: #A7F3D0;
      }
      select.status[data-value="closed"], select.ref-status[data-value="rejected"] {
        background: #F3F4F6;
        color: #374151;
        border-color: #E5E7EB;
      }

      .btn-danger {
        padding: 6px 12px; border: 1px solid var(--color-destructive); background: transparent;
        color: var(--color-destructive); border-radius: 6px; cursor: pointer; font-size: 0.8rem;
        transition: all 200ms ease;
      }
      .btn-danger:hover { background: var(--color-destructive); color: white; }

      .dir-group {
        border: 1px solid var(--color-border); border-radius: 8px; box-shadow: var(--shadow-sm);
        margin-bottom: var(--space-md); padding: var(--space-md); background: var(--color-muted);
      }
      .dir-group h3 { margin: 0 0 var(--space-md); font-size: 1.1rem; display: flex; justify-content: space-between; align-items: center; color: var(--color-primary); }
      .dir-subcat {
        border-left: 3px solid var(--color-border); margin: var(--space-sm) 0 var(--space-md) var(--space-sm);
        padding: var(--space-sm) 0 var(--space-sm) var(--space-md);
      }
      .dir-subcat h4 { margin: 0 0 var(--space-sm); font-size: 0.95rem; display: flex; justify-content: space-between; align-items: center; color: #374151; }
      
      .dir-row { display: flex; gap: var(--space-sm); align-items: center; margin-bottom: var(--space-sm); flex-wrap: wrap; }
      .dir-row .input { margin-bottom: 0; padding: 8px 12px; font-size: 0.85rem; }
      .dir-row .input.name { flex: 2; min-width: 140px; }
      .dir-row .input.note { flex: 3; min-width: 180px; }
      .dir-row .input[type="number"] { width: 60px; }
      
      .icon-btn {
        background: transparent; border: 1px solid var(--color-border); color: var(--color-foreground);
        cursor: pointer; font-size: 0.8rem; padding: 6px 10px; border-radius: 4px; transition: all 200ms ease;
      }
      .icon-btn:hover { background: var(--color-border); }
      .icon-btn.danger { border-color: var(--color-destructive); color: var(--color-destructive); }
      .icon-btn.danger:hover { background: var(--color-destructive); color: white; }

      .nb-checks { display: flex; gap: var(--space-md); font-size: 0.85rem; flex-wrap: wrap; margin-top: var(--space-sm); }
      .nb-checks label { display: flex; gap: 6px; align-items: center; cursor: pointer; color: #6B7280; font-weight: 500; }
      .nb-checks label span { display: inline-block; }
      .nb-checks input:checked + span { color: var(--color-primary); font-weight: 600; }
      
      th.sortable { cursor: pointer; user-select: none; transition: color 200ms ease; }
      th.sortable:hover { color: var(--color-foreground); }
      th.sortable .arrow { font-size: 0.9em; margin-left: 4px; }
    </style>
  </head>
  <body>
    {!isAdminSession ? (
      <div id="loginView">
        <h1>Admin Login</h1>
        <input type="email" class="input" id="loginEmail" placeholder="Email Address" autocomplete="username" />
        <input type="password" class="input" id="loginPassword" placeholder="Password" autocomplete="current-password" />
        <button id="loginBtn" class="btn-primary">Authenticate</button>
        <p id="loginError"></p>
      </div>
    ) : (
      <div id="appView">
        <div class="topbar">
          <h1>Trusted Neighbors <span style="color:var(--color-accent)">Operations</span></h1>
          <div class="topbar-right">
            <button id="logoutBtn" class="btn-secondary">Log Out</button>
          </div>
        </div>
        
        <div class="container">
          <div class="tabs-container">
            <div class="tabs">
              <button class="tab-btn active" id="tabRequestsBtn">Service Requests</button>
              <button class="tab-btn" id="tabReferralsBtn">Referral Suggestions</button>
              <button class="tab-btn" id="tabRolesBtn">Admin Roles</button>
              <button class="tab-btn" id="tabDirectoryBtn">Directory CMS</button>
            </div>
          </div>

          <div id="tab-requests">
            <div class="filters">
              <select id="filterNeighborhood" class="select-input"><option value="">All Neighborhoods</option></select>
              <select id="filterCategory" class="select-input"><option value="">All Categories</option></select>
              <select id="filterStatus" class="select-input">
                <option value="">All Statuses</option>
                <option value="new">New</option>
                <option value="contacted">Contacted</option>
                <option value="closed">Closed</option>
              </select>
            </div>
            
            <div class="card">
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th class="sortable" data-sort="created_at">Submitted <span class="arrow"></span></th>
                      <th>Neighborhood</th>
                      <th>Category</th>
                      <th class="sortable" data-sort="date_needed">Date Needed <span class="arrow"></span></th>
                      <th>Name</th>
                      <th>Phone</th>
                      <th>Email</th>
                      <th>Notes</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="requestsBody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <div id="tab-referrals" style="display:none;">
            <div class="filters">
              <select id="filterRefNeighborhood" class="select-input"><option value="">All Neighborhoods</option></select>
              <select id="filterRefStatus" class="select-input">
                <option value="">All Statuses</option>
                <option value="new">New</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
              </select>
            </div>
            
            <div class="card">
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Submitted</th>
                      <th>Neighborhood</th>
                      <th>Business / Person</th>
                      <th>Category</th>
                      <th>Phone</th>
                      <th>Referrer</th>
                      <th>Referrer Email</th>
                      <th>Note</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="referralsBody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <div id="tab-roles" style="display:none;">
            <div class="card" style="margin-bottom: var(--space-lg); max-width: 540px;">
              <h3 style="margin-top: 0; margin-bottom: var(--space-sm); color: var(--color-primary);">Grant Admin Access</h3>
              <p style="font-size: 0.88rem; color: #4B5563; margin-bottom: var(--space-md);">Registered users added here can log into this Operations Console to manage directory content, requests, and referrals.</p>
              <div style="display: flex; gap: var(--space-sm);">
                <input type="email" id="grantAdminEmail" class="input" placeholder="user@example.com" style="margin-bottom: 0;" />
                <button id="grantAdminBtn" class="btn-primary" style="white-space: nowrap; width: auto;">Grant Admin Role</button>
              </div>
              <div id="grantAdminNotice" style="margin-top: var(--space-sm); font-size: 0.85rem;"></div>
            </div>

            <div class="card">
              <h3 style="margin-top: 0; margin-bottom: var(--space-md);">Authorized Administrators</h3>
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>Email Address</th>
                      <th>Role</th>
                      <th>Added Date</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="adminsBody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <div id="tab-directory" style="display:none;">
            <div class="dir-subtabs" style="margin-bottom: var(--space-lg);">
              <button class="btn-secondary active" id="subTabListingsBtn" style="background:var(--color-border); border-color:var(--color-border)">Business Listings</button>
              <button class="btn-secondary" id="subTabCategoriesBtn">Categories & Groups</button>
            </div>

            <div id="dir-listings">
              <div class="filters" style="margin-bottom: var(--space-md); flex-wrap: wrap;">
                <select id="dirNeighborhood" class="select-input" style="flex: 1; min-width: 180px;"><option value="">All Neighborhoods</option></select>
                <select id="dirCategoryFilter" class="select-input" style="flex: 1; min-width: 180px;"><option value="">All Categories</option></select>
                <input type="text" id="dirSearch" class="input" placeholder="Search listing by name/phone…" style="flex: 2; min-width: 220px; margin-bottom: 0;" />
                <button class="btn-primary" id="openAddListingModalBtn" style="width: auto;">+ Add Listing</button>
              </div>
              
              <div class="card">
                <div class="table-scroll">
                  <table>
                    <thead>
                      <tr>
                        <th>Neighborhood</th>
                        <th>Category</th>
                        <th>Business Name</th>
                        <th>Phone</th>
                        <th>Note / Description</th>
                        <th>Featured</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="listingsBody"></tbody>
                  </table>
                </div>
              </div>
            </div>

            <div id="dir-categories" style="display:none;">
              <div style="margin-bottom: var(--space-md); text-align: right;">
                <button class="btn-primary" id="addGroupBtn" style="width: auto;">+ Add Group</button>
              </div>
              <div id="groupsList"></div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Modal: Add Listing -->
    <div id="addListingModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
      <div class="card" style="max-width:540px; width:90%; max-height:90vh; overflow-y:auto; padding:var(--space-xl); background:white;">
        <h3 style="margin-top:0; color:var(--color-primary);">+ Add Business Listing</h3>
        <form id="addListingForm">
          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Neighborhood *</label>
          <select id="addListNeighborhood" class="select-input" required style="margin-bottom:var(--space-md);"></select>

          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Subcategory *</label>
          <select id="addListSubcat" class="select-input" required style="margin-bottom:var(--space-md);"></select>

          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Business Name *</label>
          <input type="text" id="addListName" class="input" required placeholder="e.g. Austin Premier Plumbing" />

          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Phone Number *</label>
          <input type="text" id="addListPhone" class="input" required placeholder="(512) 555-0199" />

          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Email (Optional)</label>
          <input type="email" id="addListEmail" class="input" placeholder="contact@business.com" />

          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Website (Optional)</label>
          <input type="url" id="addListWebsite" class="input" placeholder="https://www.business.com" />

          <label style="font-size:0.85rem; font-weight:600; display:block; margin-bottom:4px;">Note / Description (Optional)</label>
          <input type="text" id="addListNote" class="input" placeholder="e.g. Master plumber, 24/7 emergency service" />

          <label style="font-size:0.85rem; font-weight:600; display:inline-flex; align-items:center; gap:8px; margin-bottom:var(--space-lg); cursor:pointer;">
            <input type="checkbox" id="addListFeatured" /> Highlight as Featured Provider
          </label>

          <div style="display:flex; justify-content:flex-end; gap:var(--space-md);">
            <button type="button" class="btn-secondary" id="closeAddListingModalBtn" style="width:auto;">Cancel</button>
            <button type="submit" class="btn-primary" style="width:auto;">Save Listing</button>
          </div>
        </form>
      </div>
    </div>

    <script src="../scripts/admin.js"></script>
    <script src="../scripts/admin-directory.js"></script>
  </body>
</html>
