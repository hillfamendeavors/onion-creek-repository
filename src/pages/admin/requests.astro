---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Service Requests" activeTab="requests">
  <!-- KPI Metrics Bar -->
  <div class="admin-kpi-grid">
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#EFF6FF; color:#1D4ED8;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiTotalRequests">0</div>
        <div class="admin-kpi-label">Total Requests</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#FEF3C7; color:#92400E;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiActiveRequests">0</div>
        <div class="admin-kpi-label">Active / New</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#EEF2FF; color:#4338CA;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiCompletedRequests">0</div>
        <div class="admin-kpi-label">Fulfilled</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#ECFDF5; color:#065F46;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiNeighborhoodCount">0</div>
        <div class="admin-kpi-label">Neighborhoods</div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="admin-toolbar">
    <div class="admin-search-wrapper">
      <span class="admin-search-icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <input type="text" id="reqSearchInput" class="admin-input admin-search-input" placeholder="Search by name, email, phone, notes…" />
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
      <select id="filterNeighborhood" class="admin-select">
        <option value="">All Neighborhoods</option>
      </select>
      <select id="filterCategory" class="admin-select">
        <option value="">All Categories</option>
      </select>
      <select id="filterStatus" class="admin-select">
        <option value="">All Statuses</option>
        <option value="new">New (Active)</option>
        <option value="contacted">Contacted (In Progress)</option>
        <option value="completed">Completed (Fulfilled)</option>
        <option value="closed">Closed (Cancelled)</option>
      </select>
      <button id="refreshReqBtn" class="btn-secondary" title="Refresh table data">
        ↺ Refresh
      </button>
    </div>
  </div>

  <!-- Table Card Container -->
  <div class="admin-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="sortable col-submitted" data-sort="created_at" style="width:110px;">Submitted <span class="arrow"></span></th>
            <th style="width:230px;">Neighborhood &amp; Category</th>
            <th style="width:230px;">Requester</th>
            <th style="width:140px;">Contact Phone</th>
            <th class="sortable col-date" data-sort="date_needed" style="width:140px;">Date Needed <span class="arrow"></span></th>
            <th style="min-width:180px;">Details / Notes</th>
            <th style="width:140px;">Status</th>
            <th style="width:150px; text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody id="requestsTableBody">
          <tr>
            <td colspan="8" style="text-align:center; padding:36px; color:#64748B;">
              Loading service requests…
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit Service Request Modal -->
  <div id="editRequestModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:2100; justify-content:center; align-items:center;">
    <div class="admin-card" style="max-width:540px; width:92%; max-height:90vh; overflow-y:auto; padding:28px; background:white; box-shadow:var(--shadow-lg);">
      <h3 style="margin:0 0 16px 0; color:var(--color-primary); display:flex; align-items:center; gap:8px; font-size:1.3rem;">
        ✏️ Edit Service Request
      </h3>
      <form id="editRequestForm">
        <input type="hidden" id="editReqId" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Neighborhood *</label>
            <select id="editReqNeighborhood" class="admin-select" required style="width:100%;">
              <option value="onion-creek">Onion Creek</option>
              <option value="circle-c">Circle C</option>
              <option value="avery-ranch">Avery Ranch</option>
              <option value="sunfield">Sunfield</option>
            </select>
          </div>
          <div>
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Category *</label>
            <input type="text" id="editReqCategory" class="admin-input" required placeholder="e.g. Handyman" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Date Needed *</label>
            <input type="date" id="editReqDate" class="admin-input" required />
          </div>
          <div>
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Status *</label>
            <select id="editReqStatus" class="admin-select" required style="width:100%;">
              <option value="new">New (Active)</option>
              <option value="contacted">Contacted (In Progress)</option>
              <option value="completed">Completed (Fulfilled)</option>
              <option value="closed">Closed (Cancelled)</option>
            </select>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Requester Name *</label>
            <input type="text" id="editReqName" class="admin-input" required placeholder="Full Name" />
          </div>
          <div>
            <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Phone Number *</label>
            <input type="tel" id="editReqPhone" class="admin-input" required placeholder="(512) 555-0000" />
          </div>
        </div>

        <div style="margin-bottom:12px;">
          <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Email (Optional)</label>
          <input type="email" id="editReqEmail" class="admin-input" placeholder="neighbor@example.com" />
        </div>

        <div style="margin-bottom:20px;">
          <label style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Appointment Details / Notes</label>
          <textarea id="editReqNotes" class="admin-input" rows="3" placeholder="Description of the request…" style="resize:vertical;"></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button type="button" class="btn-secondary" id="closeEditRequestModalBtn">Cancel</button>
          <button type="submit" class="btn-primary" id="saveEditRequestBtn">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script src="../../scripts/admin-requests.js"></script>
</AdminLayout>
