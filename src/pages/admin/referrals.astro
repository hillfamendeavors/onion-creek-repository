---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Referral Suggestions" activeTab="referrals">
  <!-- KPI Metrics Bar -->
  <div class="admin-kpi-grid">
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#EFF6FF; color:#1D4ED8;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiTotalReferrals">0</div>
        <div class="admin-kpi-label">Total Suggestions</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#FEF3C7; color:#92400E;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiPendingReferrals">0</div>
        <div class="admin-kpi-label">Pending Review</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#ECFDF5; color:#065F46;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiApprovedReferrals">0</div>
        <div class="admin-kpi-label">Approved &amp; Added</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#FEE2E2; color:#B91C1C;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="kpiRejectedReferrals">0</div>
        <div class="admin-kpi-label">Rejected</div>
      </div>
    </div>
  </div>

  <!-- Status Filtering Tabs -->
  <div class="ref-status-tabs" id="refStatusTabs">
    <button class="ref-status-tab active" data-tab="new" type="button">
      ⏳ Pending Review <span class="badge" id="badgePendingCount">0</span>
    </button>
    <button class="ref-status-tab" data-tab="approved" type="button">
      ✅ Approved &amp; Published <span class="badge" id="badgeApprovedCount">0</span>
    </button>
    <button class="ref-status-tab" data-tab="rejected" type="button">
      🚫 Rejected <span class="badge" id="badgeRejectedCount">0</span>
    </button>
    <button class="ref-status-tab" data-tab="all" type="button">
      All <span class="badge" id="badgeAllCount">0</span>
    </button>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="admin-toolbar">
    <div class="admin-search-wrapper">
      <span class="admin-search-icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <input type="text" id="refSearchInput" class="admin-input admin-search-input" placeholder="Search referrals by business, phone, referrer, note…" aria-label="Search referrals" />
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
      <select id="filterRefNeighborhood" class="admin-select" aria-label="Filter by neighborhood">
        <option value="">All Neighborhoods</option>
      </select>
      <button id="refreshRefBtn" class="btn-secondary" title="Refresh referrals" aria-label="Refresh referrals">
        ↺ Refresh
      </button>
    </div>
  </div>

  <!-- Moderation Cards Grid Container -->
  <div class="referral-cards-grid" id="referralsContainer">
    <div style="grid-column:1 / -1; text-align:center; padding:48px 20px; color:#64748B;">
      Loading referral suggestions…
    </div>
  </div>

  <!-- Quick Approve & Publish to Directory Modal -->
  <div id="publishReferralModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:2100; justify-content:center; align-items:center;" role="dialog" aria-modal="true" aria-labelledby="publishRefModalTitle">
    <div class="admin-card" style="max-width:580px; width:92%; max-height:90vh; overflow-y:auto; padding:28px; background:white;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 id="publishRefModalTitle" style="margin:0; color:var(--color-primary); font-size:1.3rem; display:flex; align-items:center; gap:8px;">
          ✓ Approve &amp; Publish to Directory
        </h3>
        <button type="button" class="btn-secondary" id="closePublishModalTop" style="padding:4px 8px;" aria-label="Close dialog">✕</button>
      </div>
      <p style="color:#64748B; font-size:0.85rem; margin-bottom:16px; line-height:1.4;">
        Verify business information and publish directly into the community directory.
      </p>

      <form id="publishReferralForm">
        <input type="hidden" id="pubReferralId" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label for="pubNeighborhood" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Target Directory *</label>
            <select id="pubNeighborhood" class="admin-select" required style="width:100%;">
              <option value="onion-creek">Onion Creek</option>
              <option value="circle-c">Circle C</option>
              <option value="avery-ranch">Avery Ranch</option>
              <option value="sunfield">Sunfield</option>
            </select>
          </div>
          <div>
            <label for="pubSubcat" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Category *</label>
            <select id="pubSubcat" class="admin-select" required style="width:100%;"></select>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label for="pubName" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Business / Pro Name *</label>
            <input type="text" id="pubName" class="admin-input" required placeholder="e.g. Mike's Plumbing" />
          </div>
          <div>
            <label for="pubPhone" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Business Phone *</label>
            <input type="tel" id="pubPhone" class="admin-input" required placeholder="(512) 555-0199" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label for="pubEmail" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Business Email (Optional)</label>
            <input type="email" id="pubEmail" class="admin-input" placeholder="contact@business.com" />
          </div>
          <div>
            <label for="pubWebsite" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Business Website (Optional)</label>
            <input type="url" id="pubWebsite" class="admin-input" placeholder="https://..." />
          </div>
        </div>

        <div style="margin-bottom:12px;">
          <label for="pubNote" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Recommendation Quote / Description</label>
          <textarea id="pubNote" class="admin-input" rows="3" placeholder="Neighbor recommendation text and details…"></textarea>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; background:#F8FAFC; padding:12px; border-radius:8px; border:1px solid #E2E8F0;">
          <label style="font-size:0.85rem; font-weight:700; color:#0F172A; display:inline-flex; align-items:center; gap:8px; cursor:pointer;">
            <input type="checkbox" id="pubFeatured" />
            ⭐ Feature this business (Pin to top of category)
          </label>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button type="button" class="btn-secondary" id="closePublishModalBtn">Cancel</button>
          <button type="submit" class="btn-primary" id="savePublishBtn" style="background:#059669; border-color:#059669;">
            ✓ Confirm &amp; Publish
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Referral Suggestion Modal -->
  <div id="editReferralModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:2100; justify-content:center; align-items:center;" role="dialog" aria-modal="true" aria-labelledby="editRefModalTitle">
    <div class="admin-card" style="max-width:540px; width:92%; max-height:90vh; overflow-y:auto; padding:28px; background:white;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 id="editRefModalTitle" style="margin:0; color:var(--color-primary); font-size:1.3rem; display:flex; align-items:center; gap:8px;">
          ✏️ Edit Referral Suggestion
        </h3>
        <button type="button" class="btn-secondary" id="closeEditModalTop" style="padding:4px 8px;" aria-label="Close dialog">✕</button>
      </div>

      <form id="editReferralForm">
        <input type="hidden" id="editReferralId" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label for="editName" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Business Name *</label>
            <input type="text" id="editName" class="admin-input" required />
          </div>
          <div>
            <label for="editPhone" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Business Phone *</label>
            <input type="tel" id="editPhone" class="admin-input" required />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label for="editNeighborhood" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Neighborhood</label>
            <select id="editNeighborhood" class="admin-select" style="width:100%;">
              <option value="onion-creek">Onion Creek</option>
              <option value="circle-c">Circle C</option>
              <option value="avery-ranch">Avery Ranch</option>
              <option value="sunfield">Sunfield</option>
            </select>
          </div>
          <div>
            <label for="editCategory" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Category</label>
            <input type="text" id="editCategory" class="admin-input" placeholder="e.g. Electrician" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
          <div>
            <label for="editReferrer" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Referrer Name</label>
            <input type="text" id="editReferrer" class="admin-input" />
          </div>
          <div>
            <label for="editReferrerEmail" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Referrer Email</label>
            <input type="email" id="editReferrerEmail" class="admin-input" />
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label for="editNote" style="font-size:0.82rem; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Recommendation Note</label>
          <textarea id="editNote" class="admin-input" rows="3"></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button type="button" class="btn-secondary" id="closeEditModalBtn">Cancel</button>
          <button type="submit" class="btn-primary" id="saveEditBtn">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="../../scripts/admin-referrals.js"></script>
</AdminLayout>
