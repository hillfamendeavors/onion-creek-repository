---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Operations Overview" activeTab="overview">
  <div class="admin-kpi-grid">
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#EFF6FF; color:#1D4ED8;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="statUsers">—</div>
        <div class="admin-kpi-label">Registered Users</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#FEF3C7; color:#92400E;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="statOpenRequests">—</div>
        <div class="admin-kpi-label">Open Requests</div>
      </div>
    </div>
    <div class="admin-kpi-card">
      <div class="admin-kpi-icon" style="background:#ECFDF5; color:#065F46;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
      </div>
      <div>
        <div class="admin-kpi-val" id="statPendingReferrals">—</div>
        <div class="admin-kpi-label">Pending Referrals</div>
      </div>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:20px; margin-top:24px;">
    <div class="admin-card" style="padding:24px;">
      <h3 style="margin:0 0 8px 0; color:var(--color-primary); font-size:1.25rem; font-family:'Source Serif 4', Georgia, serif;">Service Requests Hub</h3>
      <p style="color:#64748B; font-size:0.9rem; margin-bottom:16px; line-height:1.5;">
        Monitor demand, reschedule appointments, review notes, and fulfill community service requests.
      </p>
      <a href="/admin/requests/" class="btn-primary" style="font-size:0.85rem;">
        Manage Service Requests →
      </a>
    </div>

    <div class="admin-card" style="padding:24px;">
      <h3 style="margin:0 0 8px 0; color:var(--color-primary); font-size:1.25rem; font-family:'Source Serif 4', Georgia, serif;">Referral Suggestions</h3>
      <p style="color:#64748B; font-size:0.9rem; margin-bottom:16px; line-height:1.5;">
        Review recommended local businesses and service providers submitted by verified neighbors.
      </p>
      <a href="/admin/referrals/" class="btn-primary" style="font-size:0.85rem;">
        Review Referrals →
      </a>
    </div>

    <div class="admin-card" style="padding:24px;">
      <h3 style="margin:0 0 8px 0; color:var(--color-primary); font-size:1.25rem; font-family:'Source Serif 4', Georgia, serif;">Directory CMS</h3>
      <p style="color:#64748B; font-size:0.9rem; margin-bottom:16px; line-height:1.5;">
        Add business listings, configure subcategories, and manage featured vendors across neighborhoods.
      </p>
      <a href="/admin/directory/" class="btn-primary" style="font-size:0.85rem;">
        Open Directory CMS →
      </a>
    </div>
  </div>

  <script src="../../scripts/admin-overview.js"></script>
</AdminLayout>
