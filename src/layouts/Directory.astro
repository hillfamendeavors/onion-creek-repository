---
import '../styles/directory.css';

interface Props {
  title: string;
  footerLabel: string;
  theme: Record<string, string>;
  description?: string;
}

const { title, footerLabel, theme, description } = Astro.props;

const metaDescription = description || `100% neighbor-sourced local business directory for ${title}. Discover community-recommended local service providers in Austin, TX.`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://trustedneighbors.net').href;
const ogImageUrl = new URL('/favicon.svg', Astro.site || 'https://trustedneighbors.net').href;

// Per-neighborhood color palette, emitted as a global :root block.
const themeCss = `:root{${Object.entries(theme)
  .map(([k, v]) => `${k}:${v};`)
  .join('')}}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:global set:html={themeCss}></style>
    <link
      href="https://fonts.googleapis.com/css2?family=Chronicles&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QE75YFJ2ZL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QE75YFJ2ZL');
    </script>
  </head>
  <body>
    <div class="top-bar">
      <span>Austin, Texas &nbsp;·&nbsp; Neighbor-Sourced Referrals</span>
      <div id="topBarAuth" class="top-bar-auth">
        <a href="/account/" class="top-bar-login">Log In / Register</a>
      </div>
    </div>

    <slot />

    <footer>
      <strong>{footerLabel}</strong> &nbsp;·&nbsp; Austin, TX &nbsp;·&nbsp; trustedneighbors.net
    </footer>

    <script src="../scripts/directory.js"></script>
  </body>
</html>
